API=http:localhost:3001

# Stripe (test publishable key - see backend/.env.example's STRIPE_SECRET_KEY).
# Hospital subscription checkout (ServiceHospital.vue) is disabled without this.
VITE_STRIPE_PUBLISHABLE_KEY=

# Hospital subdomain sites (<slug>.VITE_ROOT_DOMAIN). Leave ROOT_DOMAIN empty to disable;
# in dev you can also open http://localhost:5173/?site=<slug>.
VITE_API_URL=http://127.0.0.1:3001/v1

# Deploy mode. prod (default): real API at VITE_API_URL. preview: no network,
# all data comes from src/mocks. Only the exact value "preview" enables mocks.
# In preview, any login succeeds and signs in as VITE_PREVIEW_ROLE
# (user | hospital | doctor | admin, default hospital). Demo site: ?site=demo-hospital
VITE_APP_MODE=prod
VITE_PREVIEW_ROLE=hospital
VITE_ROOT_DOMAIN=
VITE_APP_URL=
