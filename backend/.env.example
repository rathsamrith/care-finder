# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (same MySQL instance/schema the Laravel app currently uses)
DATABASE_URL="mysql://root:@127.0.0.1:3306/demo_projects"

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# File storage (local disk, normalized paths)
STORAGE_ROOT=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:3001/uploads

# Stripe (missing from the Laravel .env.example - STRIPE_SK - carried over here)
STRIPE_SECRET_KEY=

# Mail (same SMTP settings the Laravel app uses)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Care Finder"

# Hospital subdomain sites: allow https://<slug>.<ROOT_DOMAIN> origins (CORS_ORIGIN may be a comma-separated list)
ROOT_DOMAIN=

# Public URL of the web app - used for links in emails (reset password, "view my appointments")
APP_URL=http://localhost:5173
# Where contact-form messages are emailed (defaults to MAIL_FROM_ADDRESS)
CONTACT_INBOX=

# Appointments: default slot length, hospital wall-clock offset from UTC (Phnom Penh = +420),
# and how many hours before a confirmed appointment the reminder email goes out.
APPOINTMENT_SLOT_MINUTES=30
APP_UTC_OFFSET_MINUTES=420
APPOINTMENT_REMINDER_HOURS=24
# Set true on extra instances so only one runs the reminder job
DISABLE_REMINDERS=false
# Leave MAIL_HOST empty to log emails instead of sending them (local dev)

# Max hospitals (branches) one organization may have
MAX_HOSPITALS_PER_ORG=5

# Rate limiting (in-memory, per server process). Default per-IP requests per minute:
RATE_LIMIT_PER_MINUTE=300
# Behind a reverse proxy / load balancer set this, or every visitor shares the proxy IP:
#   true = trust X-Forwarded-For, or a number = how many proxy hops to trust
TRUST_PROXY=

# Check-in: how long before/after the appointment start it can be done (minutes),
# how far from the hospital a phone may be (metres), and how long after the start
# an unchecked-in confirmed appointment becomes a no-show (minutes).
CHECKIN_EARLY_MINUTES=60
CHECKIN_LATE_MINUTES=30
CHECKIN_RADIUS_METERS=1000
NO_SHOW_GRACE_MINUTES=60
# "Arrive by" time on the patient pass: minutes before the appointment starts
ARRIVE_EARLY_MINUTES=15
